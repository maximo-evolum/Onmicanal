{
  "name": "backend-v2",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test",
    "repair:admin": "node scripts/repair-admin-access.mjs",
    "audit:tenant-modules": "node scripts/normalize-tenant-modules.mjs",
    "normalize:tenant-modules": "node scripts/normalize-tenant-modules.mjs --apply",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node seed.js",
    "seed:realty-demo": "node scripts/seed-realty-demo-properties.mjs",
    "prisma:deploy": "prisma migrate deploy",
    "audit:production": "npm audit --omit=dev --json",
    "load:test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "redis": "^6.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "body-parser": "1.20.6",
    "socket.io-parser": "4.2.7",
    "minimatch": {
      "brace-expansion": "1.1.18"
