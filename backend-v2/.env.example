# Local development
# For Railway, DO NOT use localhost. Set DATABASE_URL=${{Postgres.DATABASE_URL}} in Railway Variables.
DATABASE_URL="postgresql://postgres:password@localhost:5432/evolum_ai"
JWT_SECRET="change_me_local"
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:3001"
OPENAI_API_KEY=""
DEFAULT_TENANT_SLUG="demo"
VERIFY_TOKEN="mi_token_dev_123"
META_ACCESS_TOKEN="dev_token"
META_APP_SECRET=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID="dev_phone_id"
WHATSAPP_BUSINESS_ACCOUNT_ID=""
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID="dev_ig_account"
INSTAGRAM_ACCESS_TOKEN=""
# Public backend URL used to expose generated campaign images to Meta.
# Railway example: https://onmicanal-backend-v2.up.railway.app
PUBLIC_BASE_URL=""
BACKEND_PUBLIC_URL=""
# Centro de Conexiones OAuth. Registra estas callback URL en cada proveedor:
# Google:    ${PUBLIC_BASE_URL}/api/connections/oauth/google/callback
# Microsoft: ${PUBLIC_BASE_URL}/api/connections/oauth/microsoft/callback
# Meta:      ${PUBLIC_BASE_URL}/api/connections/oauth/meta/callback
# Mercado Pago: ${PUBLIC_BASE_URL}/api/connections/oauth/mercadopago/callback
CONNECTIONS_STATE_SECRET="change_me_with_a_long_random_value"
CONNECTIONS_ENCRYPTION_KEY="" # 32 bytes base64 or 64 hex characters in production
SESSION_COOKIE_NAME="evolum_session"
SESSION_COOKIE_SAME_SITE="lax" # Use none only with HTTPS and an explicit CSRF/origin review.
SESSION_COOKIE_DOMAIN=""
METADATA_RETENTION_ENABLED=false # Activa solo despues de revisar el reporte de retencion.
METADATA_RETENTION_INTERVAL_MS=86400000 # Cada 24 horas; mínimo 1 hora.
WORKFLOW_SCHEDULER_INTERVAL_MS=300000 # Cada 5 minutos; mínimo 1 minuto.
REDIS_URL="" # Variable privada del servicio Redis de Railway.
METRICS_TOKEN="" # Token aleatorio para el scrape privado de /metrics.
# DOCUMENT_UPLOAD_MAX_BYTES=26214400 # 25 MB por archivo como máximo.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
CALENDAR_URL=""
PAYMENT_BASE_URL="http://localhost:3001"
ENABLE_AUTOMATION=false

# Aviso de actualización nativa para las APK/IPA. Define ambas variables de la
# plataforma para publicar el aviso. El enlace debe ser estable (no una URL
# temporal de Expo) y accesible desde el teléfono.
# Activa solo después de probar el enlace en un teléfono.
MOBILE_ANDROID_RELEASE_ENABLED=false
MOBILE_ANDROID_LATEST_VERSION=""
MOBILE_ANDROID_MINIMUM_VERSION="" # Opcional: obliga a actualizar versiones anteriores.
MOBILE_ANDROID_DOWNLOAD_URL=""
MOBILE_ANDROID_RELEASE_NOTES=""
# Activa solo después de probar TestFlight.
MOBILE_IOS_RELEASE_ENABLED=false
MOBILE_IOS_LATEST_VERSION=""
MOBILE_IOS_MINIMUM_VERSION=""
MOBILE_IOS_DOWNLOAD_URL="" # En iOS normalmente es el enlace público de TestFlight.
MOBILE_IOS_RELEASE_NOTES=""
