{
  "expo": {
    "name": "EVOLUM",
    "slug": "evolum-mobile",
    "icon": "./assets/evolum-logo.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "evolum",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8fd3d44e-a57f-4b60-b627-3dd9f72da108"
    },
    "plugins": [["expo-notifications", { "icon": "./assets/evolum-logo.png", "color": "#8A2EFF", "defaultChannel": "evolum-alerts" }]],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.evolum.mobile"
    },
    "android": {
      "package": "com.evolum.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/evolum-logo.png",
        "backgroundColor": "#070711"
      }
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api",
      "eas": {
        "projectId": "8fd3d44e-a57f-4b60-b627-3dd9f72da108"
      }
    },
    "owner": "tronquitoxd"
  }
}
