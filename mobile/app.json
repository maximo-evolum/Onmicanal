{
  "expo": {
    "name": "EVOLUM",
    "slug": "evolum-mobile",
    "icon": "./assets/evolum-app-icon.png",
    "version": "0.1.7",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "evolum",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8fd3d44e-a57f-4b60-b627-3dd9f72da108"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/evolum-app-icon.png",
          "color": "#8A2EFF",
          "defaultChannel": "evolum-alerts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EVOLUM necesita acceso a tus fotos solo cuando elijas cargar imágenes."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.evolum.mobile",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.evolum.mobile",
      "versionCode": 7,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/evolum-app-icon.png",
        "backgroundColor": "#070711"
      }
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api",
      "eas": {
        "projectId": "8fd3d44e-a57f-4b60-b627-3dd9f72da108"
      }
    },
    "owner": "tronquitoxd"
  }
}