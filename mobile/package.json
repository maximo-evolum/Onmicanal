{
  "name": "evolum-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --tunnel --clear",
    "start:lan": "expo start --lan --clear",
    "start:local": "expo start --localhost --clear",
    "android": "expo start --android --tunnel --clear",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo install --check",
    "typecheck": "tsc --noEmit",
    "build:android:apk": "powershell -NoProfile -Command \"$env:EAS_NO_VCS='1'; $env:EAS_PROJECT_ROOT=(Get-Location).Path; npx eas-cli build --platform android --profile preview\"",
    "build:ios:testflight": "powershell -NoProfile -Command \"$env:EAS_NO_VCS='1'; $env:EAS_PROJECT_ROOT=(Get-Location).Path; npx eas-cli build --platform ios --profile ios-testflight\"",
    "submit:ios:testflight": "powershell -NoProfile -Command \"$env:EAS_NO_VCS='1'; $env:EAS_PROJECT_ROOT=(Get-Location).Path; npx eas-cli submit --platform ios --latest\"",
    "update:preview": "powershell -NoProfile -Command \"$env:EAS_NO_VCS='1'; $env:EAS_PROJECT_ROOT=(Get-Location).Path; npx eas-cli update --channel preview\"",
    "update:production": "powershell -NoProfile -Command \"$env:EAS_NO_VCS='1'; $env:EAS_PROJECT_ROOT=(Get-Location).Path; npx eas-cli update --channel production\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "19.1.17",
    "typescript": "5.9.3"
  }
}
